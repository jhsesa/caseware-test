<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Caseware.Collaborate.TokenExchange</RootNamespace>
    <AssemblyName>Caseware.Collaborate.TokenExchange</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      JwtBearer pulls in Microsoft.IdentityModel.Tokens and System.IdentityModel.Tokens.Jwt
      as transitive dependencies — no manual cryptography packages needed.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <!-- L2 Redis epoch store for sub-second permission revocation. -->
    <PackageReference Include="StackExchange.Redis" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal types to the integration test project. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Caseware.Collaborate.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
